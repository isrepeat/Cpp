root = true

# Единые правила для текстовых файлов репозитория.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Visual Studio традиционно сохраняет исходный код C/C++ с UTF-8 BOM.
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,hlsl}]
charset = utf-8-bom

# Командные файлы Windows оставляем в нативном для cmd.exe формате.
[*.{bat,cmd}]
end_of_line = crlf
