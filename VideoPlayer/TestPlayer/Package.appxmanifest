<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="TestPlayer"
    Publisher="CN=isrepeat"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="6055e8f3-367d-44d1-a397-111cc2238f56" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>TestPlayer</DisplayName>
    <PublisherDisplayName>CppTeam</PublisherDisplayName>
    <Logo>..\DxPlayer\Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="TestPlayer.App">
      <uap:VisualElements
        DisplayName="TestPlayer"
        Square150x150Logo="..\DxPlayer\Assets\Square150x150Logo.png"
        Square44x44Logo="..\DxPlayer\Assets\Square44x44Logo.png"
        Description="TestPlayer"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="..\DxPlayer\Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="..\DxPlayer\Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
